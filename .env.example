# Copiar a .env y ajustar valores. .env nunca se commitea.
# Esta lista es el punto de partida: el change del esqueleto la completará.

# --- Postgres ---
POSTGRES_USER=voxel3d
POSTGRES_PASSWORD=changeme
POSTGRES_DB=voxel3d
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+psycopg://voxel3d:changeme@db:5432/voxel3d
JWT_SECRET_KEY=changeme-generate-a-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
BACKEND_CORS_ORIGINS=http://localhost:3000

# --- Stripe (SOLO claves de prueba: empiezan por sk_test_ / pk_test_) ---
# Crear una cuenta gratuita en https://dashboard.stripe.com y copiar las claves
# del modo de pruebas. El secreto del webhook lo da la Stripe CLI en local.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Email ---
# docker-compose.yml fijará SMTP_HOST/SMTP_PORT al servicio local `mailhog`
# (bandeja web en http://localhost:8025, nunca entrega a internet).
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=pedidos@voxel3d.local

# --- Frontend (Next.js) ---
# Las variables NEXT_PUBLIC_ se ven en el navegador: nunca pongas aquí secretos.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
FRONTEND_BASE_URL=http://localhost:3000
